# DBOT Environment Configuration Example

# Deriv Developer Credentials
DERIV_CLIENT_ID=your_deriv_client_id_here
DERIV_REDIRECT_URI=https://your-domain.com/callback
DERIV_LEGACY_APP_ID=1089
DERIV_API_BASE=https://api.derivws.com

# Server & Application Settings
PORT=3001
NODE_ENV=production
# PostgreSQL / Supabase connection string for production:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# SQLite connection for local development:
DATABASE_URL="file:./dev.db"

JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
